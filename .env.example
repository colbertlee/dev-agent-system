# LLM 配置（复制为 .env 后填写真实值）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：超时与重试
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# 工作目录与记忆目录（生产环境可挂载到持久卷）
WORKSPACE_DIR=./workspace
MEMORY_DIR=./memory_store

# 记忆后端：sqlite | redis | chroma（依赖缺失时自动降级）
MEMORY_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# 上下文压缩阈值（字符数）
CONTEXT_COMPRESS_THRESHOLD=6000
CONTEXT_WINDOW_LIMIT=8000

# 工作流状态持久化（断点续跑）
# CHECKPOINT_ENABLED=true
# CHECKPOINT_DB=./memory_store/checkpoints.sqlite

# 评估 benchmark 输出目录与并发数（并发>1 可能导致 SQLite checkpoint 锁，建议保持 1）
# EVAL_OUTPUT_DIR=./eval_results
# EVAL_MAX_WORKERS=1

# DevOps 真实闭环（默认 dry-run，关闭后才会执行 docker build/run）
# DEVOPS_DRY_RUN=true
# DEVOPS_TIMEOUT=120
